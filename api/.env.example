# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3001

DATABASE_URL=postgres://postgres:postgres@localhost:5432/sme_advisor

# Where the SPA runs. Magic-link URLs point here, and CORS allows exactly this.
APP_ORIGIN=http://localhost:5174

# This API's own public URL. Magic links point here, not at the SPA.
API_ORIGIN=http://localhost:3001

# Rotating this signs everyone out. 32 chars minimum.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

SESSION_TTL_HOURS=336
MAGIC_LINK_TTL_MINUTES=15

# Leave unset in development â€” magic links print to the console instead.
# Required in production; the server refuses to start without it.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM=SME Advisor <no-reply@example.com>

ANTHROPIC_API_KEY=
