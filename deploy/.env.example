# Copy to deploy/.env on the server. Never commit it.

# ─── public address ─────────────────────────────────────────────────────────
# With a domain — Caddy gets a Let's Encrypt certificate automatically:
#   SITE_ADDRESS=advisor.falak.sa
#   PUBLIC_URL=https://advisor.falak.sa
#
# Without one, plain HTTP on the VM's IP. Fine for synthetic data today;
# not a state to leave it in, because session cookies want Secure.
SITE_ADDRESS=:80
PUBLIC_URL=http://YOUR.VM.IP.HERE

# ─── database ───────────────────────────────────────────────────────────────
POSTGRES_USER=sme
POSTGRES_DB=sme_advisor
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── secrets ────────────────────────────────────────────────────────────────
# Rotating this signs everyone out. openssl rand -base64 32
SESSION_SECRET=
ANTHROPIC_API_KEY=

# ─── residency ──────────────────────────────────────────────────────────────
# `development` = synthetic data only. The API REFUSES TO START in production
# with this value — set it to in_kingdom only once the database really is in
# Saudi Arabia. Nothing can verify this; it is your assertion (D11a).
DATA_RESIDENCY=development

# ─── email ──────────────────────────────────────────────────────────────────
# Required in production — without it, sign-in links are never delivered and
# the API refuses to start.
SMTP_URL=
MAIL_FROM=SME Advisor <no-reply@falak.sa>

# ─── object storage ─────────────────────────────────────────────────────────
# Data room documents. Production refuses to start without it: files on a
# container filesystem do not survive a rebuild and nothing backs them up.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
