{
  "name": "sme-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "Investment readiness assessment for SMEs in Saudi Arabia",
  "type": "module",
  "workspaces": ["api", "web"],
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck -w @sme/api && npm run typecheck -w @sme/web",
    "dev:web": "npm run dev -w @sme/web",
    "build:prototype": "node scripts/build-prototype.mjs",
    "migrate": "npm run migrate -w @sme/api",
    "retention": "npm run retention -w @sme/api",
    "dev:api": "npm run dev -w @sme/api"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  }
}
